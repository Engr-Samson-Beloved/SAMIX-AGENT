node_modules/
dist/
build/
out/
*.tsbuildinfo
.turbo/

# TypeScript output emitted next to its own source.
#
# The frontend is a noEmit project — Vite compiles it — so any .js beside a .tsx
# is a stray from a misconfigured tsc run, never something to commit. It is
# worth ignoring rather than just deleting: `import './App'` resolves a stale
# .js in preference to the .tsx, so a leftover artifact silently shadows the
# real source and the app runs code nobody edited.
apps/desktop/src/**/*.js
apps/desktop/src/**/*.js.map
apps/desktop/vite.config.js
apps/desktop/vite.config.js.map

# Python desktop sidecar (Phase 7). The virtual environment is built on the
# user's machine by `pnpm setup:desktop`; only requirements.txt is committed.
packages/core/python/.venv/
__pycache__/
*.pyc

# Rust / Tauri
target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Secrets — spec §38: never commit credentials.
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime state (logs, sqlite, audit trail live in %APPDATA%, but never commit strays)
*.log
*.sqlite
*.sqlite-journal
logs/

# Test sandbox — spec §69
tests/sandbox/scratch/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
