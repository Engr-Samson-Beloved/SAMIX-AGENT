{
  "name": "@samix/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAMIX Agent runtime: state machine, tool registry, permission engine, observability. Runs as the Node sidecar.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "samix-core": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "dev": "node --watch --experimental-strip-types src/main.ts --dev-bridge",
    "start": "node dist/main.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@samix/shared": "workspace:*",
    "playwright-core": "^1.62.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
