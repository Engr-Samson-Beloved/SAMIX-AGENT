# SAMIX Agent — development environment template.
#
# Spec §38: `.env` is acceptable during DEVELOPMENT ONLY. The production secret
# mechanism is the Windows Credential Manager, reached through
# packages/core/src/security/secrets.ts. Nothing in this file is read in a
# packaged build.
#
# Copy to `.env` and fill in. `.env` is gitignored.

# ---------------------------------------------------------------------------
# LLM provider credentials (consumed starting Phase 3 — unused in Phase 1)
# ---------------------------------------------------------------------------
# Google Gemini is the configured engine for this build.
# GEMINI_API_KEY=

# Alternative providers, reachable through the same abstraction (spec §6).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Phase 1 runtime knobs
# ---------------------------------------------------------------------------
# Minimum level written to the log file: debug | info | warn | error | audit
SAMIX_LOG_LEVEL=debug

# Override the config/log/state directory. Defaults to %APPDATA%\SamixAgent.
# SAMIX_DATA_DIR=

# Set to 1 to mirror structured logs to stderr in addition to the log file.
# stdout is NEVER used for logs — it is the sidecar IPC channel (see ADR-0003).
SAMIX_LOG_STDERR=1
