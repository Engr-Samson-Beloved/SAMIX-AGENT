{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAMIX Agent",
  "version": "0.1.0",
  "identifier": "tech.samix.agent",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SAMIX Agent",
        "label": "main",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "samix-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/core/dist": "core"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
